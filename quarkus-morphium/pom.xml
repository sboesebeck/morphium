<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>de.caluga</groupId>
    <artifactId>morphium-parent</artifactId>
    <version>6.3.3</version>
  </parent>

  <artifactId>quarkus-morphium-parent</artifactId>
  <packaging>pom</packaging>

  <name>Quarkus Morphium Extension – Parent</name>
  <description>
    Quarkus CDI extension that integrates the Morphium MongoDB ORM.
    Provides @ApplicationScoped Morphium producer, type-safe @ConfigMapping,
    and GraalVM native reflection registration for all @Entity classes.
  </description>

  <modules>
    <module>runtime</module>
    <module>deployment</module>
    <module>testing</module>
    <module>integration-tests</module>
  </modules>

  <!-- quarkus.version is defined in morphium-parent so that a Quarkus
       upgrade is a single-line change there. Only the BOM *import* stays
       in this module's own POM: keeping it here (instead of moving it to
       morphium-parent) means no core build (morphium-core/poppydb) ever
       has to resolve Quarkus's ~400 BOM-managed artifacts just to read
       the version. -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.quarkus.platform</groupId>
        <artifactId>quarkus-bom</artifactId>
        <version>${quarkus.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>3.27.7</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <!-- maven-compiler-plugin and maven-surefire-plugin versions are
             already managed by morphium-parent; only the additional
             configuration not provided by the parent is set here. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <release>${maven.compiler.release}</release>
            <parameters>true</parameters>
            <compilerArgs>
              <arg>-Xlint:deprecation,unchecked</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <!-- Not managed by morphium-parent; version set independently here. -->
        <plugin>
          <groupId>io.quarkus</groupId>
          <artifactId>quarkus-extension-maven-plugin</artifactId>
          <version>${quarkus.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
